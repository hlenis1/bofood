:{$PORT:3000} {

    # Elimina la palabra /api antes de enviar la petición a Node.js
    handle_path /api/* {
        reverse_proxy chatpan_bofood:3000
    }

    # Manejador para servir la aplicación React
    handle {
        root * dist
        encode gzip
        file_server
        try_files {path} /index.html
    }
}