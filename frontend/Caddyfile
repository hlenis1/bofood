:{$PORT:3000} {

    # Coincidencia explícita para todas las peticiones a /api
    @api path /api/*
    handle @api {
        reverse_proxy chatpan_bofood:3000
    }

    # Manejador por defecto para servir la aplicación React compilada
    handle {
        root * dist
        encode gzip
        file_server
        try_files {path} /index.html
    }
}