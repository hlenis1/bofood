:{$PORT:3000} {

    # Redirige peticiones de API, WebSockets y las imágenes subidas al backend
    @api path /api/* /socket.io/* /uploads/*
    handle @api {
        reverse_proxy chatpan_bofood:3000
    }

    # Sirve la aplicación React compilada
    handle {
        root * dist
        encode gzip
        file_server
        try_files {path} /index.html
    }
}