:{$PORT:3000} {

    # Mantiene el prefijo /api/ y reenvía las peticiones a Express
    @api path /api/*
    handle @api {
        reverse_proxy chatpan_bofood:3000
    }

    # Sirve la aplicación React compilada
    handle {
        root * dist
        encode gzip
        file_server
        try_files {path} /index.html
    }
}