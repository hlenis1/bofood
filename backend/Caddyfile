:{$PORT:3000} {
    log {
        format json
    }

    # Redireccionar el tráfico /api hacia el servicio backend en la red Docker
    handle /api/* {
        reverse_proxy chatpan_bofood:3000
    }

    # Servir la SPA de React (Vite / Static)
    handle {
        root * ../app/{$NIXPACKS_SPA_OUTPUT_DIR}
        encode gzip
        file_server
        try_files {path} /index.html
    }
}